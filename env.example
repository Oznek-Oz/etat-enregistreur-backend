# Copiez ce fichier en ".env" pour les tests en local (vercel dev),
# et renseignez les mêmes valeurs dans Vercel > Project Settings > Environment Variables
# pour le déploiement en production. Ne commitez jamais le fichier ".env" réel.

# Adresse Gmail du Chef Unité MIRE (l'expéditeur des emails).
GMAIL_USER=chef.unite.mire@gmail.com

# Mot de passe d'application Gmail (PAS le mot de passe du compte).
# À générer sur https://myaccount.google.com/apppasswords (nécessite la
# validation en 2 étapes activée sur le compte Google). Voir README.md.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Clé secrète que l'application frontend doit envoyer dans l'en-tête X-Api-Key
# pour être autorisée à utiliser ce backend. Choisissez une longue chaîne
# aléatoire (ex: générée avec `openssl rand -hex 32`).
BACKEND_API_KEY=2111b5ea67a9669ca2c0e7f0a2f1a6f0e53f85c8081e90cd86bc581377d07850

SIGNATURE_DRIVE_FILE_ID=1SlN5o_rCKIM1sT6yJqmv3E_uXq_7sb2K


curl.exe -i https://etat-enregistreur-backend.vercel.app/api/get-signature -H "X-Api-Key: eaab81f97c0a48f6018cb257d43a7ea4d4e273e372cf45140f0eb8780d80a04f"